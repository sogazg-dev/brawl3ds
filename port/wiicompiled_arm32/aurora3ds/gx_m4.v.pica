; Renderer milestone 4 vertex shader: GX transform, per-vertex GX lighting of channel COLOR0A0, three
; texture-coordinate generators.
; Inputs: position (object space); the channel's material color (0-255: the vertex color or the material
; register); the GX matrix row of the vertex's position matrix (PNMTXIDX: 0, 3, ..., 27, or the current matrix)
; with the object-space normal (x127); texture-coordinate set A (u, v in 1/512 steps); set B (the same), loaded
; only for batches that read two sets (twoset): the others keep the four inputs, and v4 is never read for them.
; Uniforms: the GX projection (4 rows, pre-rotated for the 240x400 portrait framebuffer: rows 1, -0, 2, 3, with the
; GX viewport folded in), the 10 GX position matrices (3 rows each), per texture unit a source selector (weights of
; set A, set B, the object position and the object normal) and a texture matrix (rows s, t, q; q = (0, 0, 0, 1) for
; a 2x4 GX matrix); for lighting the ambient color, the batch's light model and up to 8 lights.
;
;
; GX fog, per vertex (when the batch's material leaves texture unit 2 and a combiner stage free): the fog amount
; from the vertex's GX screen depth d = z/w + 1 (the projection keeps it equal), as Aurora's shader.cpp:
;   ze = A / (B - K d) (perspective; A = a * 2^24, B = b, K = 2^(24 - shift)) or a d (orthographic)
;   F = clamp(ze - c), then linear F, exp 1 - 2^(-8F), exp2 1 - 2^(-8F^2), revexp 2^(-8(1-F)),
;   revexp2 2^(-8(1-F)^2)
; It leaves as unit 2's s coordinate, into an 8-texel alpha ramp: a last combiner stage blends to the fog color by it.
;
; GX lighting (as Aurora's shader.cpp lighting_func, per vertex, in view space):
;   lacc = ambient + sum over the channel's lights of color * attn * diff, clamped to 0..1; channel = material * lacc
;   ldir = normalize(light.pos - pos), dist = |light.pos - pos|
;   GX_AF_SPOT: c = max(0, ldir . light.dir), attn = max(0, cosatt . (1, c, c^2) / distatt . (1, dist, dist^2))
;   GX_AF_SPEC: c = n . ldir >= 0 ? max(0, n . light.dir) : 0, attn = max(0, cosatt . (1, c, c^2) / distatt . (1, c, c^2))
;   GX_AF_NONE: attn = 1 (the CPU passes cosatt = distatt = (1, 0, 0) with the spot model)
;   GX_DF_NONE: diff = 1, GX_DF_SIGN: n . ldir, GX_DF_CLAMP: max(0, n . ldir)
; The normal comes from the position matrix (normalized: uniform scale drops out; GX uses the separate normal
; matrix, equal to it up to scale for rotations and uniform scaling).

.fvec proj[4]
.fvec posmtx[30]
.fvec texmtx[9]
.fvec texsrc[3]
.fvec amb          ; rgb: COLOR0 ambient, a: ALPHA0 ambient (1 for an unlit part)
.fvec lsel         ; (spec model 0/1, diffuse uses n.l 0/1, floor of n.l: 0 clamp, -2 sign, 0)
.fvec lights[40]   ; per light: pos, dir, color (masked per part), cosatt, distatt
.ivec lightloop    ; (lights - 1, 0, 5, 0)
.bool lit
.fvec fogp[3]      ; (A, B, K, c), (perspective weight, orthographic weight, a, 0), (reverse, squared, linear, 0)
.bool fogv         ; per-vertex fog for this batch
.bool twoset       ; the batch's vertices carry set B (input v4)

.constf consts(1.0, 0.0, 0.00392156862745098, 0.001953125)
.constf consts2(0.0078740157480315, 0.0, 0.0, 0.0)
.constf fogk(2.0, -8.0, 0.875, 0.0625)   ; 2, -8, and the ramp's texel mapping s = F * 7/8 + 1/16
.constf fogk2(0.5, 0.0, 0.0, 0.0)
.alias ones consts.xxxx
.alias zeros consts.yyyy
.alias inv255 consts.zzzz
.alias inv512 consts.wwww
.alias inv127 consts2.xxxx

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outtc2 texcoord2

.alias inpos v0
.alias inclr v1
.alias inrow v2
.alias inuv v3
.alias inuv2 v4

.proc main
    ; object -> view with the vertex's position matrix (a0.x = its first row)
    mova a0.x, inrow.x
    mov r0.xyz, inpos
    mov r0.w, ones
    dp4 r1.x, posmtx[a0.x], r0
    dp4 r1.y, posmtx[a0.x+1], r0
    dp4 r1.z, posmtx[a0.x+2], r0
    mov r1.w, ones

    ; view -> clip
    dp4 r2.x, proj[0], r1
    dp4 r2.y, proj[1], r1
    dp4 r2.z, proj[2], r1
    dp4 r2.w, proj[3], r1
    mov outpos, r2

    ; texture-coordinate sources: A = (uA, vA, 1, 1), B = (uB, vB, 1, 1), position = r0, normal = (n, 1)
    mul r3.xy, inv512, inuv.xy
    mov r3.zw, ones
    mov r4.xy, zeros
    ifu twoset
        mul r4.xy, inv512, inuv2.xy
    .end
    mov r4.zw, ones
    mul r11.xyz, inv127, inrow.yzww
    mov r11.w, ones

    ; unit 0
    mul r5, texsrc[0].xxxx, r3
    mad r5, r4, texsrc[0].yyyy, r5
    mad r5, r0, texsrc[0].zzzz, r5
    mad r5, r11, texsrc[0].wwww, r5
    dp4 r6.x, texmtx[0], r5
    dp4 r6.y, texmtx[1], r5
    dp4 r6.z, texmtx[2], r5
    rcp r6.z, r6.z
    mul r6.xy, r6.zz, r6.xy
    mov r6.zw, ones
    mov outtc0, r6

    ; unit 1
    mul r5, texsrc[1].xxxx, r3
    mad r5, r4, texsrc[1].yyyy, r5
    mad r5, r0, texsrc[1].zzzz, r5
    mad r5, r11, texsrc[1].wwww, r5
    dp4 r7.x, texmtx[3], r5
    dp4 r7.y, texmtx[4], r5
    dp4 r7.z, texmtx[5], r5
    rcp r7.z, r7.z
    mul r7.xy, r7.zz, r7.xy
    mov r7.zw, ones
    mov outtc1, r7

    ; unit 2
    mul r5, texsrc[2].xxxx, r3
    mad r5, r4, texsrc[2].yyyy, r5
    mad r5, r0, texsrc[2].zzzz, r5
    mad r5, r11, texsrc[2].wwww, r5
    dp4 r8.x, texmtx[6], r5
    dp4 r8.y, texmtx[7], r5
    dp4 r8.z, texmtx[8], r5
    rcp r8.z, r8.z
    mul r8.xy, r8.zz, r8.xy
    mov r8.zw, ones

    ; per-vertex fog: its amount as unit 2's coordinate (r2 = the clip position)
    ifu fogv
        rcp r13.x, r2.wwww
        mul r13.x, r13.xxxx, r2.zzzz
        add r13.x, ones, r13.xxxx              ; d
        mul r13.y, fogp[0].zzzz, r13.xxxx      ; K d
        add r13.y, fogp[0].yyyy, -r13.yyyy     ; B - K d
        rcp r13.y, r13.yyyy
        mul r13.y, fogp[0].xxxx, r13.yyyy      ; A / (B - K d)
        mul r13.y, fogp[1].xxxx, r13.yyyy      ; perspective weight
        mul r13.z, fogp[1].zzzz, r13.xxxx      ; a d
        mad r13.y, r13.zzzz, fogp[1].yyyy, r13.yyyy   ; ze
        add r13.y, -fogp[0].wwww, r13.yyyy     ; ze - c
        max r13.y, zeros, r13.yyyy
        min r13.y, ones, r13.yyyy              ; F
        mul r13.z, fogk.xxxx, r13.yyyy         ; 2F
        add r13.z, ones, -r13.zzzz             ; 1 - 2F
        mad r13.z, r13.zzzz, fogp[2].xxxx, r13.yyyy   ; G = F, or 1 - F reversed
        mul r13.w, r13.zzzz, r13.zzzz
        add r13.w, r13.wwww, -r13.zzzz
        mad r13.w, r13.wwww, fogp[2].yyyy, r13.zzzz   ; X = G, or G^2 squared
        mul r13.w, fogk.yyyy, r13.wwww         ; -8 X
        ex2 r13.w, r13.wwww                    ; E = 2^(-8 X)
        mul r14.x, fogk.xxxx, r13.wwww         ; 2E
        add r14.x, -ones, r14.xxxx             ; 2E - 1
        add r14.y, ones, -r13.wwww             ; 1 - E
        mad r14.x, r14.xxxx, fogp[2].xxxx, r14.yyyy   ; 1 - E, or E reversed
        add r14.z, r13.yyyy, -r14.xxxx
        mad r14.x, r14.zzzz, fogp[2].zzzz, r14.xxxx   ; F when linear
        max r14.x, zeros, r14.xxxx
        min r14.x, ones, r14.xxxx
        mul r14.x, fogk.zzzz, r14.xxxx
        add r14.x, fogk.wwww, r14.xxxx         ; the ramp texel
        mov r14.y, fogk2.xxxx
        mov r14.zw, ones
        mov r8, r14
    .end
    mov outtc2, r8

    ; channel color: the material color, times the lighting when the batch is lit
    mul r12, inv255, inclr
    ifu lit
        ; view-space normal
        mul r2.xyz, inv127, inrow.yzww
        mov r2.w, zeros
        dp3 r3.x, posmtx[a0.x], r2
        dp3 r3.y, posmtx[a0.x+1], r2
        dp3 r3.z, posmtx[a0.x+2], r2
        dp3 r3.w, r3, r3
        rsq r3.w, r3.w
        mul r3.xyz, r3.wwww, r3
        mov r10.x, ones          ; r10 = (1, 0): constants as a temp (one uniform per instruction)
        mov r10.y, zeros
        mov r4, amb              ; lacc
        for lightloop
            add r5.xyz, lights[aL], -r1
            dp3 r5.w, r5, r5             ; dist^2
            rsq r6.x, r5.wwww            ; 1 / dist
            mul r5.xyz, r6.xxxx, r5      ; ldir
            rcp r6.y, r6.xxxx            ; dist
            dp3 r6.z, r3, r5             ; n . ldir
            dp3 r7.x, lights[aL+1], r5   ; ldir . dir
            dp3 r7.y, lights[aL+1], r3   ; n . dir
            max r7.xy, zeros, r7         ; spot cosine, max(0, n . dir)
            sge r7.z, r6.zzzz, r10.yyyy  ; n . ldir >= 0
            mul r7.y, r7.zzzz, r7.yyyy   ; spec cosine
            add r7.w, r7.yyyy, -r7.xxxx
            mad r7.w, r7.wwww, lsel.xxxx, r7.xxxx   ; c = spot or spec cosine
            add r8.x, r7.wwww, -r6.yyyy
            mad r8.x, r8.xxxx, lsel.xxxx, r6.yyyy   ; the distance term's variable: dist (spot) or c (spec)
            mov r9.x, r10.xxxx
            mov r9.y, r7.wwww
            mul r9.z, r7.wwww, r7.wwww
            dp3 r9.w, lights[aL+3], r9   ; cosatt . (1, c, c^2)
            mov r9.y, r8.xxxx
            mul r9.z, r8.xxxx, r8.xxxx
            dp3 r9.y, lights[aL+4], r9   ; distatt . (1, d, d^2)
            rcp r9.y, r9.yyyy
            mul r9.w, r9.wwww, r9.yyyy
            max r9.w, zeros, r9.wwww     ; attn
            max r6.z, lsel.zzzz, r6.zzzz ; n . ldir with its floor
            add r6.z, r6.zzzz, -r10.xxxx
            mad r6.z, r6.zzzz, lsel.yyyy, r10.xxxx  ; diff: 1 or n . ldir
            mul r6.z, r9.wwww, r6.zzzz
            mul r5, lights[aL+2], r6.zzzz
            add r4, r4, r5
        .end
        max r4, zeros, r4
        min r4, ones, r4
        mul r12, r12, r4
    .end
    mov outclr, r12
    end
.end
