; Renderer milestone 2 vertex shader: GX transform, vertex color only.
; Inputs: position (object space), color (0-255 per channel) and the GX matrix row of the vertex's position matrix
; (PNMTXIDX: 0, 3, ..., 27, or the current matrix when the format has none).
; Uniforms: the GX projection (4 rows) and the 10 GX position matrices (3 rows each, as GX stores them).
; The 3DS top screen is a 240x400 portrait framebuffer: the projection uniform comes pre-rotated (see below).

.fvec proj[4]
.fvec posmtx[30]

.constf consts(1.0, 0.0, 0.00392156862745098, -1.0)
.alias ones consts.xxxx
.alias zeros consts.yyyy
.alias inv255 consts.zzzz

.out outpos position
.out outclr color

.alias inpos v0
.alias inclr v1
.alias inrow v2

.proc main
    ; object -> view with the vertex's position matrix (a0.x = its first row)
    mova a0.x, inrow.x
    mov r0.xyz, inpos
    mov r0.w, ones
    dp4 r1.x, posmtx[a0.x], r0
    dp4 r1.y, posmtx[a0.x+1], r0
    dp4 r1.z, posmtx[a0.x+2], r0
    mov r1.w, ones

    ; view -> clip
    dp4 r2.x, proj[0], r1
    dp4 r2.y, proj[1], r1
    dp4 r2.z, proj[2], r1
    dp4 r2.w, proj[3], r1

    ; The uploaded projection already carries the quarter turn the 240x400 portrait framebuffer needs (rows 1, -0,
    ; 2, 3, as citro3d's Mtx_*Tilt do it). Rotating here, or writing outpos one component at a time, drew nothing.
    mov outpos, r2

    mul outclr, inv255, inclr
    end
.end
