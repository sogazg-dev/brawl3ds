; Renderer bring-up self-test shader: the smallest transform (one 4x4 matrix, color passed through). Used only by
; pica_renderer_3ds.cpp's SelfTest to tell a broken GX shader from a broken render path.

.fvec mvp[4]

.constf consts(0.0, 1.0, 0.0, 0.0)
.alias ones consts.yyyy

.out outpos position
.out outclr color

.alias inpos v0
.alias inclr v1

.proc main
    mov r0.xyz, inpos
    mov r0.w, ones
    dp4 outpos.x, mvp[0], r0
    dp4 outpos.y, mvp[1], r0
    dp4 outpos.z, mvp[2], r0
    dp4 outpos.w, mvp[3], r0
    mov outclr, inclr
    end
.end
