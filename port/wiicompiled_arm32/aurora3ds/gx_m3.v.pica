; Renderer milestone 3 vertex shader: GX transform, channel color and three texture-coordinate generators.
; Inputs: position (object space), channel color (0-255), the GX matrix row of the vertex's position matrix
; (PNMTXIDX: 0, 3, ..., 27, or the current matrix), and one texture-coordinate set (u, v in 1/512 steps; set B,
; from the loader's (z, w) = (0, 1), is unused: its weights are 0).
; Uniforms: the GX projection (4 rows, pre-rotated for the 240x400 portrait framebuffer: rows 1, -0, 2, 3), the 10
; GX position matrices (3 rows each), and per texture unit a source selector (weights of set A, set B and the
; object position) and a texture matrix (rows s, t, q; q = (0, 0, 0, 1) for a 2x4 GX matrix).

.fvec proj[4]
.fvec posmtx[30]
.fvec texmtx[9]
.fvec texsrc[3]

.constf consts(1.0, 0.0, 0.00392156862745098, 0.001953125)
.alias ones consts.xxxx
.alias inv255 consts.zzzz
.alias inv512 consts.wwww

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outtc2 texcoord2

.alias inpos v0
.alias inclr v1
.alias inrow v2
.alias inuv v3

.proc main
    ; object -> view with the vertex's position matrix (a0.x = its first row)
    mova a0.x, inrow.x
    mov r0.xyz, inpos
    mov r0.w, ones
    dp4 r1.x, posmtx[a0.x], r0
    dp4 r1.y, posmtx[a0.x+1], r0
    dp4 r1.z, posmtx[a0.x+2], r0
    mov r1.w, ones

    ; view -> clip
    dp4 r2.x, proj[0], r1
    dp4 r2.y, proj[1], r1
    dp4 r2.z, proj[2], r1
    dp4 r2.w, proj[3], r1
    mov outpos, r2

    mul outclr, inv255, inclr

    ; texture-coordinate sources: A = (uA, vA, 1, 1), B = (uB, vB, 1, 1), position = r0
    mul r3.xy, inv512, inuv.xy
    mov r3.zw, ones
    mov r4.xy, inuv.zw
    mov r4.zw, ones

    ; unit 0
    mul r5, texsrc[0].xxxx, r3
    mad r5, r4, texsrc[0].yyyy, r5
    mad r5, r0, texsrc[0].zzzz, r5
    dp4 r6.x, texmtx[0], r5
    dp4 r6.y, texmtx[1], r5
    dp4 r6.z, texmtx[2], r5
    rcp r6.z, r6.z
    mul r6.xy, r6.zz, r6.xy
    mov r6.zw, ones
    mov outtc0, r6

    ; unit 1
    mul r5, texsrc[1].xxxx, r3
    mad r5, r4, texsrc[1].yyyy, r5
    mad r5, r0, texsrc[1].zzzz, r5
    dp4 r7.x, texmtx[3], r5
    dp4 r7.y, texmtx[4], r5
    dp4 r7.z, texmtx[5], r5
    rcp r7.z, r7.z
    mul r7.xy, r7.zz, r7.xy
    mov r7.zw, ones
    mov outtc1, r7

    ; unit 2
    mul r5, texsrc[2].xxxx, r3
    mad r5, r4, texsrc[2].yyyy, r5
    mad r5, r0, texsrc[2].zzzz, r5
    dp4 r8.x, texmtx[6], r5
    dp4 r8.y, texmtx[7], r5
    dp4 r8.z, texmtx[8], r5
    rcp r8.z, r8.z
    mul r8.xy, r8.zz, r8.xy
    mov r8.zw, ones
    mov outtc2, r8
    end
.end
